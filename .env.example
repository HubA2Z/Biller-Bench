# Database
DATABASE_URL="postgresql://billerbench:billerbench@localhost:5432/billerbench"

# Public site URL (used in Stripe redirects, sitemap, canonical URLs)
APP_URL="http://localhost:3000"

# Session signing secret: generate with `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-string"

# Stripe (leave blank in development and set DEV_FAKE_PAYMENTS=true)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASIC=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_DEDICATED=""

# Skip Stripe and mark payments as paid immediately. Never enable in production.
DEV_FAKE_PAYMENTS="true"

# Password for staff accounts created by the seed script
SEED_STAFF_PASSWORD="change-me-now"

# Email (Resend). Leave RESEND_API_KEY blank in development: emails print to the server log.
RESEND_API_KEY=""
EMAIL_FROM="BillerBench <notifications@yourdomain.com>"
# Optional: comma-separated addresses for team alerts. Default: all team members with emails on.
STAFF_ALERT_EMAILS=""

# Rate limiting reads the visitor IP from X-Forwarded-For. Set to "false" if the app is not behind a proxy.
TRUST_PROXY="true"
